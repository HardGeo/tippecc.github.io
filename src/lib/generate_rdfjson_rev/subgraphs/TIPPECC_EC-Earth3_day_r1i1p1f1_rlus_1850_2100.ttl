exe:Slice_TIPPECC_area_1167 a prov:Activity ;
    rdfs:label "Slice TIPPECC area" ;
    prov:description "Slice the dataset to the TIPPECC area." ;
    prov:function "FUNCTION__CDO_SELLONLATBOX" ;
    prov:params "{'lonmin': 10.0, 'lonmax': 51.81, 'latmin': -35.97, 'latmax': -4.95}" ;
    prov:startedAtTime "2025-01-21T15:05:07"^^xsd:dateTime ;
    prov:wasAssociatedWith software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy exe:Slice_years_1166 .

exe:Slice_years_1166 a prov:Activity ;
    rdfs:label "Slice years" ;
    prov:description "Slice the dataset between 1850 and 2100." ;
    prov:function "FUNCTION__CDO_SELYEAR" ;
    prov:params "{'start_year': '1850', 'end_year': '2100'}" ;
    prov:startedAtTime "2025-01-21T15:02:10"^^xsd:dateTime ;
    prov:wasAssociatedWith software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy exe:Merge_datasets_1165 .

