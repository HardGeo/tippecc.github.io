exe:Calc_pot._ET_830 a prov:Activity ;
    rdfs:label "Calc pot. ET" ;
    prov:description "Calculate potential evapotranspiration with the FAO_PM98 method." ;
    prov:function "FUNCTION__XCLIM_EVAPOTRANSPIRATION" ;
    prov:params "{'tasmin': 'tasmin.tasmin', 'tasmax': 'tasmax.tasmax', 'hurs': 'hurs.hurs', 'rsds': 'rsds.rsds', 'rsus': 'rsus.rsus', 'rlus': 'rlus.rlus', 'rlds': 'rlds.rlds', 'sfcWind': 'sfcWind.sfcWind', 'method': 'FAO_PM98'}" ;
    prov:startedAtTime "2025-01-24T15:35:39-01:00"^^xsd:dateTime ;
    prov:used tippecc_data:TIPPECC_ACCESS-ESM1-5_day_r1i1p1f1_hurs_1950_2100,
        tippecc_data:TIPPECC_ACCESS-ESM1-5_day_r1i1p1f1_rlds_1950_2100,
