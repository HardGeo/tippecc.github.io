        tippecc_data:TIPPECC_ACCESS-ESM1-5_day_r1i1p1f1_rsus_1950_2100,
        tippecc_data:TIPPECC_ACCESS-ESM1-5_day_r1i1p1f1_sfcWind_1950_2100,
        tippecc_data:TIPPECC_ACCESS-ESM1-5_day_r1i1p1f1_tasmax_1950_2100,
        tippecc_data:TIPPECC_ACCESS-ESM1-5_day_r1i1p1f1_tasmin_1950_2100 ;
    prov:wasAssociatedWith software:FUNCTION__XCLIM_EVAPOTRANSPIRATION,
        software:SOFTWARE__XCLIM_0_49 ;
