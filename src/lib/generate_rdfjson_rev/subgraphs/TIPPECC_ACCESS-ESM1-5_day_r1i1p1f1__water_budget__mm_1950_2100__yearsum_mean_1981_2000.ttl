exe:Calc_water_budget_838 a prov:Activity ;
    rdfs:label "Calc water budget" ;
    prov:description "Calculate the water budget as the difference between precipitation and potential evapotranspiration." ;
    prov:function "FUNCTION__XCLIM_WATER_BUDGET" ;
    prov:params "{'pr': 'pr.pr', 'evspsblpot': 'evapo.evspsblpot'}" ;
    prov:startedAtTime "2025-01-24T15:36:56-01:00"^^xsd:dateTime ;
    prov:used tippecc_data:TIPPECC_ACCESS-ESM1-5_day_r1i1p1f1__evspsblpot_1950_2100,
        tippecc_data:TIPPECC_ACCESS-ESM1-5_day_r1i1p1f1_pr_1950_2100 ;
    prov:wasAssociatedWith software:FUNCTION__XCLIM_WATER_BUDGET,
        software:SOFTWARE__XCLIM_0_49 ;
    prov:wasInformedBy exe:Calc_pot._ET_830,
        <http://www.provbook.org/tippecc/exe/Rename/Metadata_762> .

