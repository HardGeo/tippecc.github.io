exe:Calc_mean_1953 a prov:Activity ;
    rdfs:label "Calc mean" ;
    prov:description "Calculate the mean of the dataset between 1981 and 2000." ;
    prov:function "FUNCTION__CDO_TIMMEAN" ;
    prov:params "N/A" ;
    prov:startedAtTime "2025-03-04T20:07:47-01:00"^^xsd:dateTime ;
    prov:wasAssociatedWith software:FUNCTION__CDO_TIMMEAN,
        software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy exe:Slice_ref._period_1952 .

exe:Slice_ref._period_1952 a prov:Activity ;
    rdfs:label "Slice ref. period" ;
    prov:description "Slice a reference period from the dataset between 1981 and 2000." ;
    prov:function "FUNCTION__CDO_SELYEAR" ;
    prov:params "{'start_year': '1981', 'end_year': '2000'}" ;
    prov:startedAtTime "2025-03-04T20:07:47-01:00"^^xsd:dateTime ;
    prov:used tippecc_data:TIPPECC_MIROC-ES2H_day_r1i1p4f2_pr__mm_1850_2100__yearsum ;
    prov:wasAssociatedWith software:FUNCTION__CDO_SELYEAR,
        software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy exe:Calc_year_sum_1956 .

