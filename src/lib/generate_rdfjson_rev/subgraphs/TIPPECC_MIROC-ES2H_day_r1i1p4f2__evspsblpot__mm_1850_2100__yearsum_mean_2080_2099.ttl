exe:Calc_mean_1999 a prov:Activity ;
    rdfs:label "Calc mean" ;
    prov:description "Calculate the mean of the dataset between 2080 and 2099." ;
    prov:function "FUNCTION__CDO_TIMMEAN" ;
    prov:params "N/A" ;
    prov:startedAtTime "2025-03-04T20:13:47-01:00"^^xsd:dateTime ;
    prov:wasAssociatedWith software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy exe:Slice_ref._period_1998 .

exe:Slice_ref._period_1998 a prov:Activity ;
    rdfs:label "Slice ref. period" ;
