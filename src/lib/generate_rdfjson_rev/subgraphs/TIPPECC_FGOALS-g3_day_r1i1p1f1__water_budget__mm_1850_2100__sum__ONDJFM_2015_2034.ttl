exe:Calc_mean_1330 a prov:Activity ;
    rdfs:label "Calc mean" ;
    prov:description "Calculate the mean of the dataset between 2015 and 2034." ;
    prov:function "FUNCTION__CDO_TIMMEAN" ;
    prov:params "N/A" ;
    prov:startedAtTime "2025-03-04T21:02:17-01:00"^^xsd:dateTime ;
    prov:wasAssociatedWith software:FUNCTION__CDO_TIMMEAN,
        software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy exe:Slice_ref._period_1329 .

exe:Slice_ref._period_1329 a prov:Activity ;
    rdfs:label "Slice ref. period" ;
    prov:description "Slice a reference period from the dataset between 2015 and 2034." ;
    prov:function "FUNCTION__CDO_SELYEAR" ;
    prov:params "{'start_year': '2015', 'end_year': '2034'}" ;
    prov:startedAtTime "2025-03-04T21:02:17-01:00"^^xsd:dateTime ;
    prov:used tippecc_data:TIPPECC_FGOALS-g3_day_r1i1p1f1__water_budget__mm_1850_2100__sum__ONDJFM_1851_2100 ;
