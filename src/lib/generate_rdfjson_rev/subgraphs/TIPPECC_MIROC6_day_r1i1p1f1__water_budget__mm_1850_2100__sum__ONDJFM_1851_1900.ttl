exe:Calc_mean_2207 a prov:Activity ;
    rdfs:label "Calc mean" ;
    prov:description "Calculate the mean of the dataset between 1851 and 1900." ;
    prov:function "FUNCTION__CDO_TIMMEAN" ;
    prov:params "N/A" ;
    prov:startedAtTime "2025-01-24T20:14:00-01:00"^^xsd:dateTime ;
    prov:wasAssociatedWith software:FUNCTION__CDO_TIMMEAN,
        software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy exe:Slice_ref._period_2206 .

exe:Slice_ref._period_2206 a prov:Activity ;
    rdfs:label "Slice ref. period" ;
    prov:description "Slice a reference period from the dataset between 1851 and 1900." ;
    prov:function "FUNCTION__CDO_SELYEAR" ;
    prov:params "{'start_year': '1851', 'end_year': '1900'}" ;
    prov:startedAtTime "2025-01-24T20:14:00-01:00"^^xsd:dateTime ;
    prov:used tippecc_data:TIPPECC_MIROC6_day_r1i1p1f1__water_budget__mm_1850_2100__sum__ONDJFM_1851_2100 ;
    prov:wasAssociatedWith software:FUNCTION__CDO_SELYEAR,
        software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy <http://www.provbook.org/tippecc/exe/Delete_first_&_last_timesteps_2208> .

