exe:Calc_mean_2689 a prov:Activity ;
    rdfs:label "Calc mean" ;
    prov:description "Calculate the mean of the dataset between 2080 and 2099." ;
    prov:function "FUNCTION__CDO_TIMMEAN" ;
    prov:params "N/A" ;
    prov:startedAtTime "2025-01-24T21:44:01-01:00"^^xsd:dateTime ;
    prov:wasAssociatedWith software:FUNCTION__CDO_TIMMEAN,
        software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy exe:Slice_ref._period_2688 .

exe:Slice_ref._period_2688 a prov:Activity ;
    rdfs:label "Slice ref. period" ;
    prov:description "Slice a reference period from the dataset between 2080 and 2099." ;
    prov:function "FUNCTION__CDO_SELYEAR" ;
    prov:params "{'start_year': '2080', 'end_year': '2099'}" ;
    prov:startedAtTime "2025-01-24T21:44:01-01:00"^^xsd:dateTime ;
    prov:used tippecc_data:TIPPECC_NorESM2-MM_day_r1i1p1f1__evspsblpot__mm_1850_2100__yearsum ;
    prov:wasAssociatedWith software:FUNCTION__CDO_SELYEAR,
        software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy exe:Calc_year_sum_2690 .

