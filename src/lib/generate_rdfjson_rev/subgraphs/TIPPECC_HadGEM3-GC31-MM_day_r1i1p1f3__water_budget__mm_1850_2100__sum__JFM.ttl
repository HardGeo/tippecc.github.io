exe:Calc_season_sum_1624 a prov:Activity ;
    rdfs:label "Calc season sum" ;
    prov:description "Calculate the sum of the selected months (1,2,3)." ;
    prov:function "FUNCTION__CDO_YEARSUM" ;
    prov:params "{'months': '1,2,3'}" ;
    prov:startedAtTime "2025-03-04T19:26:46-01:00"^^xsd:dateTime ;
    prov:used tippecc_data:TIPPECC_HadGEM3-GC31-MM_day_r1i1p1f3__water_budget__mm_1850_2100 ;
    prov:wasAssociatedWith software:FUNCTION__CDO_YEARSUM,
        software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy <http://www.provbook.org/tippecc/exe/Convert_water_budget_to_mm/day_1612> .

