software:FUNCTION__XCLIM_EVAPOTRANSPIRATION a prov:Agent ;
    sdo:description "xclim is a library for the analysis of climate data. It is designed to work with xarray datasets and follows the CF conventions. It is part of the PyData ecosystem and is built on top of xarray and dask." ;
    sdo:license "MIT" ;
    sdo:name "xclim" ;
    sdo:softwareVersion "0.49.0" ;
    sdo:type "sdo:SoftwareApplication" ;
    sdo:url "https://xclim.readthedocs.io/en/stable/" .

