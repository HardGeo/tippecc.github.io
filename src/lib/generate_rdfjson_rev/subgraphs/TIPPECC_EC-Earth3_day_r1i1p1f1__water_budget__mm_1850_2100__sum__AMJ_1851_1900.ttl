exe:Calc_mean_1217 a prov:Activity ;
    rdfs:label "Calc mean" ;
    prov:description "Calculate the mean of the dataset between 1851 and 1900." ;
    prov:function "FUNCTION__CDO_TIMMEAN" ;
    prov:params "N/A" ;
    prov:startedAtTime "2025-02-10T11:36:35-01:00"^^xsd:dateTime ;
    prov:wasAssociatedWith software:FUNCTION__CDO_TIMMEAN,
        software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy exe:Slice_ref._period_1216 .

exe:Slice_ref._period_1216 a prov:Activity ;
    rdfs:label "Slice ref. period" ;
    prov:description "Slice a reference period from the dataset between 1851 and 1900." ;
    prov:function "FUNCTION__CDO_SELYEAR" ;
    prov:params "{'start_year': '1851', 'end_year': '1900'}" ;
    prov:startedAtTime "2025-02-10T11:36:35-01:00"^^xsd:dateTime ;
    prov:used tippecc_data:TIPPECC_EC-Earth3_day_r1i1p1f1__water_budget__mm_1850_2100__sum__AMJ ;
    prov:wasAssociatedWith software:FUNCTION__CDO_SELYEAR,
        software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy exe:Calc_season_sum_1220 .

software:FUNCTION__CDO_TIMMEAN a prov:Agent ;
    sdo:description "This module computes the temporal mean of the input field." ;
    sdo:name "timmean - time mean" ;
    sdo:targetProduct software:SOFTWARE__CDO ;
    sdo:type "sdo:SoftwareSourceCode" .

software:FUNCTION__CDO_YEARSUM a prov:Agent ;
    sdo:description "This module computes the sum of the input field over a year." ;
    sdo:name "Year sum" ;
    sdo:targetProduct software:SOFTWARE__CDO ;
    sdo:type "sdo:SoftwareSourceCode" .

software:FUNCTION__XCLIM_EVAPOTRANSPIRATION a prov:Agent ;
    sdo:description "The potential for water evaporation from soil and transpiration by plants if the water supply is sufficient, calculated with a given method." ;
    sdo:name "Evapotranspiration" ;
    sdo:targetProduct software:SOFTWARE__XCLIM ;
    sdo:type "sdo:SoftwareSourceCode" ;
    sdo:url "https://xclim.readthedocs.io/en/stable/api_indicators.html#xclim.indicators.atmos.potential_evapotranspiration" .

software:FUNCTION__XCLIM_RATE2AMOUNT a prov:Agent ;
    sdo:description "Convert a rate variable to an amount by multiplying by the sampling period length." ;
    sdo:name "Rate to amount" ;
    sdo:targetProduct software:SOFTWARE__XCLIM ;
    sdo:type "sdo:SoftwareSourceCode" ;
    sdo:url "https://xclim.readthedocs.io/en/stable/apidoc/xclim.core.html#xclim.core.units.rate2amount" .

software:FUNCTION__XCLIM_WATER_BUDGET a prov:Agent ;
    sdo:description "Precipitation minus potential evapotranspiration as a measure of an approximated surface water budget." ;
    sdo:name "Water budget" ;
    sdo:targetProduct software:SOFTWARE__XCLIM ;
    sdo:type "sdo:SoftwareSourceCode" ;
    sdo:url "https://xclim.readthedocs.io/en/stable/api_indicators.html#xclim.indicators.atmos.water_budget" .

