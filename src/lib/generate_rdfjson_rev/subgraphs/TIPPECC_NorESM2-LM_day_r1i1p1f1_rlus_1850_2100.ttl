        software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy exe:Slice_years_2544 .

exe:Slice_years_2544 a prov:Activity ;
    rdfs:label "Slice years" ;
    prov:description "Slice the dataset between 1850 and 2100." ;
    prov:function "FUNCTION__CDO_SELYEAR" ;
    prov:params "{'start_year': '1850', 'end_year': '2100'}" ;
    prov:startedAtTime "2025-01-21T15:46:02"^^xsd:dateTime ;
    prov:wasAssociatedWith software:FUNCTION__CDO_SELYEAR,
        software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy exe:Merge_datasets_2543 .

