exe:Calc_abs._change_1995 a prov:Activity ;
    rdfs:label "Calc abs. change" ;
    prov:description "Calculate absolute change for the time period 2080-2099 relative to 1981-2000." ;
    prov:function "FUNCTION__CDO_SUB" ;
    prov:params "N/A" ;
    prov:startedAtTime "2025-03-04T20:13:54-01:00"^^xsd:dateTime ;
    prov:used tippecc_data:TIPPECC_MIROC-ES2H_day_r1i1p4f2__evspsblpot__mm_1850_2100__yearsum_mean_1981_2000,
        tippecc_data:TIPPECC_MIROC-ES2H_day_r1i1p4f2__evspsblpot__mm_1850_2100__yearsum_mean_2080_2099 ;
    prov:wasAssociatedWith software:FUNCTION__CDO_SUB,
        software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy exe:Calc_mean_1997,
        exe:Calc_mean_1999 .

