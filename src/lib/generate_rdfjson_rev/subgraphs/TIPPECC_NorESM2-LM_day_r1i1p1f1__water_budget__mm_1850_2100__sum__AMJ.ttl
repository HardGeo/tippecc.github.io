exe:Calc_season_sum_2598 a prov:Activity ;
    rdfs:label "Calc season sum" ;
    prov:description "Calculate the sum of the selected months (4,5,6)." ;
    prov:function "FUNCTION__CDO_YEARSUM" ;
    prov:params "{'months': '4,5,6'}" ;
    prov:startedAtTime "2025-01-24T21:25:10-01:00"^^xsd:dateTime ;
    prov:used tippecc_data:TIPPECC_NorESM2-LM_day_r1i1p1f1__water_budget__mm_1850_2100 ;
    prov:wasAssociatedWith software:FUNCTION__CDO_YEARSUM,
        software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy <http://www.provbook.org/tippecc/exe/Convert_water_budget_to_mm/day_2592> .

