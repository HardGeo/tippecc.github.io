exe:Calc_water_budget_1711 a prov:Activity ;
    rdfs:label "Calc water budget" ;
    prov:description "Calculate the water budget as the difference between precipitation and potential evapotranspiration." ;
    prov:function "FUNCTION__XCLIM_WATER_BUDGET" ;
    prov:params "{'pr': 'pr.pr', 'evspsblpot': 'evapo.evspsblpot'}" ;
    prov:startedAtTime "2025-01-24T18:59:40-01:00"^^xsd:dateTime ;
    prov:used tippecc_data:TIPPECC_IPSL-CM6A-LR_day_r1i1p1f1__evspsblpot_1850_2100,
        tippecc_data:TIPPECC_IPSL-CM6A-LR_day_r1i1p1f1_pr_1850_2100 ;
    prov:wasAssociatedWith software:SOFTWARE__XCLIM_0_49 ;
    prov:wasInformedBy exe:Calc_pot._ET_1703,
        <http://www.provbook.org/tippecc/exe/Rename/Metadata_1651> .

<http://www.provbook.org/tippecc/exe/Convert_water_budget_to_mm/day_1712> a prov:Activity ;
