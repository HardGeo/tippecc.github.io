exe:Calc_month_sum_\(3_m_shift\)_2811 a prov:Activity ;
    rdfs:label "Calc month sum (3 m shift)" ;
    prov:description "Calculate the sum of the selected months (7,8,9,10,11,12) with a 3 month shift." ;
    prov:function "FUNCTION__CDO_YEARSUM_SHIFTTIME" ;
    prov:params "{'months': '7,8,9,10,11,12', 'shifttime': '-3mo'}" ;
    prov:startedAtTime "2025-01-24T22:03:25-01:00"^^xsd:dateTime ;
    prov:used tippecc_data:TIPPECC_TaiESM1_day_r1i1p1f1__water_budget__mm_1850_2100 ;
    prov:wasAssociatedWith software:FUNCTION__CDO_YEARSUM_SHIFTTIME,
        software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy <http://www.provbook.org/tippecc/exe/Convert_water_budget_to_mm/day_2792> .

