exe:Slice_TIPPECC_area_1067 a prov:Activity ;
    rdfs:label "Slice TIPPECC area" ;
    prov:description "Slice the dataset to the TIPPECC area." ;
    prov:function "FUNCTION__CDO_SELLONLATBOX" ;
    prov:params "{'lonmin': 10.0, 'lonmax': 51.81, 'latmin': -35.97, 'latmax': -4.95}" ;
    prov:startedAtTime "2025-01-21T14:53:05"^^xsd:dateTime ;
    prov:wasAssociatedWith software:FUNCTION__CDO_SELLONLATBOX,
        software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy exe:Slice_years_1066 .

exe:Slice_years_1066 a prov:Activity ;
    rdfs:label "Slice years" ;
    prov:description "Slice the dataset between 1850 and 2100." ;
    prov:function "FUNCTION__CDO_SELYEAR" ;
    prov:params "{'start_year': '1850', 'end_year': '2100'}" ;
    prov:startedAtTime "2025-01-21T14:50:08"^^xsd:dateTime ;
    prov:wasAssociatedWith software:FUNCTION__CDO_SELYEAR,
        software:SOFTWARE__CDO_1_9_3 ;
    prov:wasInformedBy exe:Merge_datasets_1065 .

