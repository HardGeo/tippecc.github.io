    tippecc_data:rlds.original_name "mo: (stash: m01s02i207, lbproc: 128)"^^xsd:string ;
    tippecc_data:rlds.standard_name "surface_downwelling_longwave_flux_in_air"^^xsd:string ;
    tippecc_data:rlds.units "W m-2"^^xsd:string ;
